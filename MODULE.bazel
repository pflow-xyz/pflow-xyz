"""pflow-xyz: pure-Bazel (Bzlmod) build.

Visual Petri net editor + Go backend. Dependencies are sourced from go.mod via
Gazelle's go_deps extension, so `go build`/`go test` and the Makefile keep
working alongside Bazel — Bazel is the hermetic verification build here, not the
shipping path (pflow.dev deploys with `make build`).

This module also EXPORTS the canonical browser modules under //public. They are
the source of truth for bitwrap-io, stackedup-gg and modeldao-org, each of which
vendors a copy because each embeds or serves its own static assets. See
//public:BUILD.bazel and the vendoring contract in CLAUDE.md.
"""

module(
    name = "pflow_xyz",
    version = "0.0.0",
)

bazel_dep(name = "rules_go", version = "0.61.1", repo_name = "io_bazel_rules_go")
bazel_dep(name = "gazelle", version = "0.51.3", repo_name = "bazel_gazelle")

# Hermetic Go SDK, pinned to the ecosystem-wide line (1.26.0) so compiled actions
# share remote-cache keys with go-pflow and the other consumers: the rules_go
# version and the Go SDK both feed Bazel's action key, so they must match
# graph-wide for cross-repo cache reuse. go.mod's `go` directive is lower (1.25.0);
# the SDK only needs to be >= it. nogo runs static analysis at build time.
go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.0")
go_sdk.nogo(nogo = "//:nogo")

# External Go deps come straight from go.mod / go.sum.
go_deps = use_extension("@bazel_gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

# gnark-crypto's amd64/arm64 assembly reaches here indirectly, via go-ethereum's
# KZG path. Each ecc/<curve>/<fp|fr>/element_<arch>.s does a relative
# cross-package #include of a separate vendoring-hack package (gnark-crypto issue
# #619) that rules_go cannot stage as an asm include, so the sandboxed assemble
# fails. This is the same patch go-pflow carries — both repos pin gnark-crypto
# v0.19.2 — and it inlines the included content directly into each consuming .s.
# Regenerate after a bump with go-pflow's scripts/gen-gnark-asm-patch.sh.
go_deps.module_override(
    patch_strip = 1,
    patches = ["//bazel/patches:gnark-crypto-asm-hermetic.patch"],
    path = "github.com/consensys/gnark-crypto",
)

# `bazel mod tidy` populates this use_repo list from the go.mod graph.
use_repo(go_deps, "com_github_ethereum_go_ethereum", "com_github_fogleman_gg", "com_github_ipfs_go_cid", "com_github_multiformats_go_multibase", "com_github_multiformats_go_multihash", "com_github_pflow_xyz_go_pflow", "com_github_piprate_json_gold", "com_github_skip2_go_qrcode", "org_golang_x_image")
