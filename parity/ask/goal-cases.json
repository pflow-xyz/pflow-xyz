    {"id":"best_setting-2","text":"What's the optimal rate for making lattes?","net":"coffeeshop","goal":"best_setting","inputs":{"transition":"make_latte"},"engine":"ssa","why":"Optimal rate of the transition make_latte."},
    {"id":"best_setting-3","text":"Find the best setting for the serve rate, up to 5.","net":"cafe","goal":"best_setting","inputs":{"transition":"serve","max_rate":5},"engine":"ssa","why":"Best setting of serve's rate, with the upper bound the person gave."},
