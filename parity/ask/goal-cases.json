  "cases": [
    {"id":"stuck-1","text":"Could the café ever freeze up with nobody able to do anything?","net":"cafe","goal":"stuck","inputs":{},"engine":"ssa","why":"Asks about getting stuck (deadlock); the goal takes no inputs."},
    {"id":"stuck-2","text":"Is there any way this queue ends up completely stuck?","net":"gated","goal":"stuck","inputs":{},"engine":"ssa","why":"Same question in a queue's words."},
    {"id":"stuck-3","text":"Will the coffee shop ever jam so that no order can move?","net":"coffeeshop","goal":"stuck","inputs":{},"engine":"ssa","why":"A jam where nothing can fire is a deadlock."},
    {"id":"stuck-4","text":"Does it deadlock?","net":"cafe","goal":"stuck","inputs":{},"engine":"ssa","why":"The technical word for the same question."},
    {"id":"can_happen-1","text":"Can everyone eventually end up recovered?","net":"sir","goal":"can_happen","inputs":{"to":{"R":1000}},"engine":"ode","why":"A situation to reach: all 1000 people in R."},
    {"id":"can_happen-2","text":"Is it possible for the lock to be set while the queue is full?","net":"gated","goal":"can_happen","inputs":{"to":{"Lock":1,"Queue":3}},"engine":"ssa","why":"A target marking from two places; Queue's capacity is 3."},
    {"id":"can_happen-3","text":"Can we ever have 5 completed orders?","net":"coffeeshop","goal":"can_happen","inputs":{"to":{"orders_complete":5}},"engine":"ssa","why":"A target count on one place; 'completed orders' is orders_complete."},
    {"id":"unbounded-1","text":"Does anything in this net grow without limit?","net":"explode","goal":"unbounded","inputs":{},"engine":"ssa","why":"Unbounded growth, no inputs."},
    {"id":"unbounded-2","text":"Is there a place where tokens just pile up forever?","net":"coffeeshop","goal":"unbounded","inputs":{},"engine":"ssa","why":"Piling up forever is unboundedness."},
    {"id":"unbounded-3","text":"Could any of these counts blow up?","net":"sir","goal":"unbounded","inputs":{},"engine":"ode","why":"Blow up means grow without limit (the answer here is no)."},
    {"id":"conserved-1","text":"Is the total number of people always the same?","net":"sir","goal":"conserved","inputs":{},"engine":"ode","why":"A conserved total is a P-invariant."},
    {"id":"conserved-2","text":"Is there any quantity that never changes here?","net":"explode","goal":"conserved","inputs":{},"engine":"ssa","why":"Asks for an invariant (the answer here is none)."},
    {"id":"conserved-3","text":"Does the system keep any balance, like a fixed total across places?","net":"coffeeshop","goal":"conserved","inputs":{},"engine":"ssa","why":"A fixed total across places is an invariant."},
    {"id":"average-1","text":"What does the outbreak do on average over time?","net":"sir","goal":"average","inputs":{},"engine":"ode","why":"On average over time is the mean-field trajectory."},
    {"id":"average-2","text":"How does the shop typically evolve over the day?","net":"coffeeshop","goal":"average","inputs":{},"engine":"ssa","why":"Typically evolve means the average trajectory."},
    {"id":"average-3","text":"Use the ODE to show me the typical behaviour of the café.","net":"cafe","goal":"average","inputs":{},"engine":"ssa","why":"The person names an engine, so the model passes engine_override ode (the guard will warn: the engine recommends SSA).","engine_override":"ode"},
    {"id":"average-4","text":"What is the mean trajectory of A?","net":"explode","goal":"average","inputs":{},"engine":"ssa","why":"Mean trajectory, in so many words."},
    {"id":"risk-1","text":"How bad can the outbreak get? What's the spread?","net":"sir","goal":"risk","inputs":{},"engine":"ode","why":"The goal's own question: worst case and spread."},
    {"id":"risk-2","text":"What's the worst case for the queue?","net":"cafe","goal":"risk","inputs":{},"engine":"ssa","why":"Worst case is the spread of the stochastic runs; the goal takes no inputs."},
    {"id":"risk-3","text":"How uncertain is the outcome? Give me the range.","net":"gated","goal":"risk","inputs":{},"engine":"ssa","why":"Uncertainty and range are the spread."},
    {"id":"risk-4","text":"Give me the spread of the orders using the SDE.","net":"coffeeshop","goal":"risk","inputs":{},"engine":"ssa","why":"Spread is the risk goal; the person names the SDE, so engine_override sde.","engine_override":"sde"},
    {"id":"knob-1","text":"Which setting matters most for how many people get served?","net":"cafe","goal":"knob","inputs":{"observable":"served"},"engine":"ssa","why":"Which setting matters is knob; the outcome is the place served."},
    {"id":"knob-2","text":"What should I change to make the peak of the infection smaller?","net":"sir","goal":"knob","inputs":{"observable":"I"},"engine":"ode","why":"What to change is the influence reading; the outcome is the infected place I."},
    {"id":"knob-3","text":"What has the biggest effect on completed orders?","net":"coffeeshop","goal":"knob","inputs":{"observable":"orders_complete"},"engine":"ssa","why":"Biggest effect is knob; completed orders is orders_complete."},
    {"id":"knob-4","text":"Which rate is most sensitive for how much work ends up in Done?","net":"gated","goal":"knob","inputs":{"observable":"Done"},"engine":"ssa","why":"Sensitive rate is knob; the outcome is named: Done."},
    {"id":"one_more-1","text":"What if I had one more barista?","net":"cafe","goal":"one_more","inputs":{"place":"barista_free"},"engine":"ssa","why":"One more of a resource: the pool place barista_free."},
