# Shared CID parity corpus: fixtures plus the golden CIDs both the Go side
# (//internal/seal:seal_test) and the JS side (parity/parity_check.mjs) must
# reproduce. A divergence between them is the failure this corpus exists to
# catch, so both sides read these same files.
filegroup(
    name = "golden",
    srcs = ["golden.json"] + glob(["fixtures/*"]),
    visibility = ["//visibility:public"],
)

# The /mcp workbench tools' parity suite (cmd/webserver/mcp_workbench_parity_test.go
# and mcp_workbench_test.go): pflow-native's goldens and the fixtures the cases name.
filegroup(
    name = "native_mcp",
    srcs = ["native/mcp_goldens.json"] + glob([
        "native/fixtures/*",
        "fixtures/*",
    ]),
    visibility = ["//visibility:public"],
)

# The /mcp game tools' parity suite (cmd/webserver/mcp_game_parity_test.go and
# mcp_game_test.go, internal/gamesearch's tests): pflow-native's goldens, the
# fixtures they name, and the generator's pins.
filegroup(
    name = "native_game",
    srcs = [
        "native/game_goldens.json",
        "native/gen-game/Cargo.toml",
    ] + glob(["native/fixtures/*"]),
    visibility = ["//visibility:public"],
)

# The model-identity corpus (internal/model's tests, cmd/webserver/composition_test.go,
# parity/model_check.mjs): the shared golden CIDs, the fixtures they name, the
# flat-net goldens and the net fixtures the wrapper cases point at.
filegroup(
    name = "model",
    srcs = glob([
        "model/**",
        "fixtures/*",
    ]),
    visibility = ["//visibility:public"],
)
