load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "webserver_lib",
    srcs = [
        "content_negotiation.go",
        "deploy.go",
        "files.go",
        "llm.go",
        "llm_goals.go",
        "llm_turn.go",
        "main.go",
        "mcp.go",
        "mcp_game.go",
        "mcp_model.go",
        "mcp_model_catalog.go",
        "mcp_model_read.go",
        "mcp_model_rules.go",
        "mcp_oauth.go",
        "mcp_registry.go",
        "mcp_simulate_gated.go",
        "mcp_workbench.go",
        "mcp_workbench_engine.go",
        "metrics.go",
        "share_card.go",
        "share_page.go",
        "sitemap.go",
        "wasm.go",
    ],
    embedsrcs = [
        "prompts/draft-net-v1.md",
        "prompts/turn-v1.md",
    ],
    importpath = "github.com/pflow-xyz/pflow-xyz/cmd/webserver",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/auth",
        "//internal/gamesearch",
        "//internal/llm",
        "//internal/seal",
        "//internal/static",
        "//internal/store",
        "//internal/svg",
        "//internal/userfiles",
        "@com_github_fogleman_gg//:gg",
        "@com_github_pflow_xyz_go_pflow//metamodel",
        "@com_github_pflow_xyz_go_pflow//parser",
        "@com_github_pflow_xyz_go_pflow//petri",
        "@com_github_pflow_xyz_go_pflow//reachability",
        "@com_github_pflow_xyz_go_pflow//saga",
        "@com_github_pflow_xyz_go_pflow//solver",
        "@com_github_pflow_xyz_go_pflow//stochastic",
        "@com_github_pflow_xyz_go_pflow//validation",
        "@com_github_pflow_xyz_go_pflow//verify",
        "@com_github_skip2_go_qrcode//:go-qrcode",
        "@org_golang_x_image//font",
        "@org_golang_x_image//font/gofont/gobold",
        "@org_golang_x_image//font/gofont/goregular",
        "@org_golang_x_image//font/opentype",
    ],
)

go_binary(
    name = "webserver",
    embed = [":webserver_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "webserver_test",
    srcs = [
        "author_identity_test.go",
        "content_negotiation_test.go",
        "files_test.go",
        "llm_eval_test.go",
        "llm_goals_test.go",
        "llm_test.go",
        "llm_turn_test.go",
        "mcp_game_parity_test.go",
        "mcp_game_test.go",
        "mcp_model_limits_test.go",
        "mcp_model_review_test.go",
        "mcp_model_test.go",
        "mcp_models_parity_test.go",
        "mcp_oauth_test.go",
        "mcp_pages_test.go",
        "mcp_registry_test.go",
        "mcp_simulate_gated_test.go",
        "mcp_test.go",
        "mcp_workbench_parity_test.go",
        "mcp_workbench_test.go",
        "sample_card_test.go",
        "share_card_test.go",
        "sitemap_test.go",
        "wasm_test.go",
    ],
    # keep: share_card_test.go renders a stored example model from //examples.
    # keep: llm_goals_test.go reads public/goals.json, the catalog the server embeds.
    # keep: mcp_workbench_parity_test.go replays parity/native/mcp_goldens.json on its
    # fixtures and checks the goldens' pflow-native commit against pflow-native-wasm.lock.
    # keep: mcp_game_parity_test.go replays parity/native/game_goldens.json on its fixtures.
    # keep: mcp_models_parity_test.go replays the pflow_bundle_* cases of the same
    # parity/native/mcp_goldens.json on the bundle fixtures under parity/native/fixtures
    # and on the cafe showcase bundle (//examples/showcase), which mcp_model_test.go reads too.
    data = [
        "//:pflow-native-wasm.lock",
        "//examples",
        "//examples/showcase",
        "//parity:native_game",
        "//parity:native_mcp",
        "//public:public_files",
    ],
    embed = [":webserver_lib"],
    deps = [
        "//internal/auth",
        "//internal/llm",
        "//internal/static",
        "//internal/userfiles",
        "@com_github_pflow_xyz_go_pflow//metamodel",
        "@com_github_pflow_xyz_go_pflow//solver",
    ],
)
