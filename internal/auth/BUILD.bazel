load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "auth",
    srcs = [
        "app_verifier.go",
        "auth.go",
        "verifier.go",
    ],
    importpath = "github.com/pflow-xyz/pflow-xyz/internal/auth",
    visibility = ["//:__subpackages__"],
